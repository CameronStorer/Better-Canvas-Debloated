{
  "manifest_version": 3,
  "name": "Debloated Dashboard for Canvas",
  "description": "A lightweight, private set of tweaks for Canvas: dark mode, better to-do list, GPA calculator and more. No tracking.",
  "version": "1.0.1",
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "action": {
    "default_icon": {
      "19": "icon/icon-19.png",
      "38": "icon/icon-38.png"
    },
    "default_popup": "html/popup.html",
    "default_title": "Debloated Dashboard for Canvas"
  },
  "background": {
    "service_worker": "js/background.js",
    "scripts": [
      "js/background.js"
    ]
  },
  "options_page": "html/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "js/content.js"
      ],
      "css": [
        "css/content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "debloated-dashboard-for-canvas@cameronstorer",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "short_name": "Debloated Dashboard"
}
